# Copy missing settings into your existing .env; do not overwrite real values.
SECRET_KEY=replace-with-a-long-random-local-secret
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

POSTGRES_DB=comments
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-local-password
POSTGRES_HOST=localhost

# Register reCAPTCHA v3 keys; allow localhost on a separate development key.
# V2 keys and the old RECAPTCHA_TEST_MODE setting are no longer used.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
